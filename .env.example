# DoD Cybersecurity Operations Framework - Environment Configuration Template
# Classification: UNCLASSIFIED // FOR OFFICIAL USE ONLY (FOUO)
#
# Copy to .env and set values for your environment. Never commit .env to version control.
# Streamlit-specific secrets (passwords, API keys) belong in dashboard/.streamlit/secrets.toml

# --- Application ---
DASHBOARD_CONFIG_PATH=dashboard/config/config.yaml
LOG_LEVEL=INFO
PYTHONPATH=dashboard/src

# --- Encryption (Fernet key for sensitive data at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AWS GovCloud ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-gov-west-1
AWS_SESSION_TOKEN=

# --- Azure Government ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_AUTHORITY_HOST=https://login.microsoftonline.us/

# --- Platform One ---
PLATFORM_ONE_API_KEY=
PLATFORM_ONE_API_ENDPOINT=https://api.platform-one.mil

# --- HashiCorp Vault ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=

# --- Monitoring & Alerting ---
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
ELASTICSEARCH_URL=

# --- Performance / API Gateway (when deployed behind reverse proxy) ---
API_RATE_LIMIT=100
API_TIMEOUT=30
