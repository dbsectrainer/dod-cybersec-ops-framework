flowchart TB
    %% Styling
    classDef default fill:#f9f9f9,stroke:#333,stroke-width:1px;
    classDef identity fill:#e6f3ff,stroke:#333;
    classDef network fill:#f0fff0,stroke:#333;
    classDef data fill:#fff0f0,stroke:#333;
    classDef monitor fill:#f0f0ff,stroke:#333;

    %% Identity & Access
    subgraph ID[Identity & Access]
        PIV[PIV/CAC]
        MFA[Multi-Factor Auth]
        RBAC[Role-Based Access]
        JIT[Just-in-Time Access]
        
        PIV --> MFA
        MFA --> RBAC
        RBAC --> JIT
    end
    class ID identity

    %% Network Security
    subgraph NET[Network Security]
        MICRO[Micro-segmentation]
        SDP[Software-Defined Perimeter]
        ENC[Encryption]
        FW[Next-Gen Firewall]
        
        MICRO --> SDP
        SDP --> ENC
        ENC --> FW
    end
    class NET network

    %% Data Protection
    subgraph DATA[Data Protection]
        CLASS[Data Classification]
        CRYPT[Encryption at Rest]
        DLP[Data Loss Prevention]
        RIGHTS[Rights Management]
        
        CLASS --> CRYPT
        CRYPT --> DLP
        DLP --> RIGHTS
    end
    class DATA data

    %% Continuous Monitoring
    subgraph MON[Continuous Monitoring]
        SIEM[SIEM Platform]
        EDR[EDR/XDR]
        UEBA[User Behavior Analytics]
        TI[Threat Intelligence]
        
        SIEM --> EDR
        EDR --> UEBA
        UEBA --> TI
    end
    class MON monitor

    %% Policy Enforcement
    subgraph POL[Policy Enforcement]
        ENGINE[Policy Engine]
        ENFORCE[Policy Enforcer]
        AUDIT[Policy Auditor]
        
        ENGINE --> ENFORCE
        ENFORCE --> AUDIT
    end

    %% Trust Algorithm
    subgraph TRUST[Trust Algorithm]
        SCORE[Trust Score]
        RISK[Risk Assessment]
        CONTEXT[Context Analysis]
        
        SCORE --> RISK
        RISK --> CONTEXT
    end

    %% Cross-Component Relationships
    JIT --> ENGINE
    FW --> ENGINE
    RIGHTS --> ENGINE
    TI --> RISK

    %% Access Flow
    subgraph FLOW[Access Flow]
        REQ[Access Request]
        EVAL[Trust Evaluation]
        GRANT[Access Grant]
        
        REQ --> EVAL
        EVAL --> GRANT
    end

    %% Monitoring Flow
    ENFORCE --> SIEM
    AUDIT --> UEBA
    CONTEXT --> MICRO

    %% Device Security
    subgraph DEV[Device Security]
        POSTURE[Security Posture]
        COMPLY[Compliance Check]
        HEALTH[Health Status]
        
        POSTURE --> COMPLY
        COMPLY --> HEALTH
    end

    HEALTH --> SCORE
