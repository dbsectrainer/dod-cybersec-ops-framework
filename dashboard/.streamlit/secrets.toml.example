# DoD Cybersecurity Operations Dashboard Secrets — EXAMPLE TEMPLATE
# Classification: UNCLASSIFIED // FOR OFFICIAL USE ONLY (FOUO)
#
# Copy this file to secrets.toml (same directory) and replace every value
# below before running the app. secrets.toml is gitignored and must never
# be committed with real credentials.

[passwords]
admin = "CHANGE_ME_local_dev_only"
test_user = "CHANGE_ME_local_dev_only"

[cloud]
aws_region = "us-gov-west-1"
azure_environment = "AzureUSGovernment"

[api_keys]
platform_one = "CHANGE_ME_replace_with_actual_key"
