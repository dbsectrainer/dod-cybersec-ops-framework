# Copy to .env (gitignored) and set real values before running docker-compose
# in anything beyond local/dev use. docker-compose automatically reads a
# sibling .env file.

# Grafana admin console
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Vault dev-mode root token and test-user password (dev-mode only — never
# use this pattern for a production Vault deployment)
VAULT_DEV_ROOT_TOKEN_ID=dev-only-token
VAULT_TEST_USER_PASSWORD=testpass123
